<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UserMapper">

    <resultMap id="userMap" type="com.example.demo.entity.User">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
    </resultMap>

    <select id="selectById" resultMap="userMap" parameterType="java.lang.Long">
        SELECT id, username, email, status
        FROM t_user
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="userMap" parameterType="java.lang.String">
        SELECT id, username, email, status
        FROM t_user
        WHERE username = #{username}
    </select>

    <select id="selectAll" resultMap="userMap">
        SELECT id, username, email, status
        FROM t_user
    </select>

    <insert id="insert" parameterType="com.example.demo.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (username, email, status)
        VALUES (#{username}, #{email}, #{status})
    </insert>

    <update id="updateStatus" parameterType="com.example.demo.entity.User">
        UPDATE t_user SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM t_user WHERE id = #{id}
    </delete>

</mapper>
